[sub_resource type="GDScript" id="GDScript_0sxtl"]
resource_name = "PlayerScript"
script/source = "extends Sprite2D

@export var end_turn_button: Button

func play_turn():
	print(\"Player turn begins.\")
	await end_turn_button.pressed
	print(\"Player turn ends.\")
"

[sub_resource type="GDScript" id="GDScript_g18wv"]
resource_name = "TurnNumber"
script/source = "extends RichTextLabel

@export var target: Node

func _ready() -> void:
	text = \"Turn %d\" % target.turn_number
	target.turn_number_changed.connect(_on_turn_number_changed)
	
func _on_turn_number_changed(new_value: int) -> void:
	text = \"Turn %d\" % new_value
"

